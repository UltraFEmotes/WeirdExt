# Publish an explicit source-only tree. Old captures and scratch files stay local.
/*
!/.gitignore
!/README.md
!/LICENSE
!/THIRD_PARTY.md
!/requirements.txt
!/main.py
!/build.py
!/dump_offsets.py
!/inspect_camera_accessors.py
!/inspect_geometry_accessors.py
!/inspect_movement_accessors.py
!/inspect_physics_accessors.py
!/update_profile.py
!/probe_offsets.py
!/probe_jump_velocity.py
!/rbxl/
!/dumper/
!/profiles/
!/third_party/
!/dumps/
!/export_offsets.py

/rbxl/*
!/rbxl/*.py
!/rbxl/*.mm
# Obsolete readers and the old third-party seed are not runtime dependencies.
/rbxl/state.py
/rbxl/offsets.py

/dumper/*
!/dumper/*.py
!/dumper/*.c

__pycache__/
*.py[cod]
.DS_Store
*.bin
*.log
*.app/
*.dylib
*.o
.venv/
.weirdext-native/
/dumper/sweepc
/snapshot/
/tests/
